# Default local mode: demo. Set firebase to enable real authentication and storage.
POLIS_MODE=demo
# Exact site origin required in Firebase mode, without a trailing slash.
POLIS_ORIGIN=
# Firebase web configuration and server project ID
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Firebase Admin uses Application Default Credentials.
# For local Firebase use, point GOOGLE_APPLICATION_CREDENTIALS outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=
